rules_version = '2';

// Sin Firebase Auth — el acceso real lo controla VITE_ACCESS_KEY en el frontend.
// Cuando agregues Auth, reemplazá `if true` por `if request.auth != null`.

service cloud.firestore {
  match /databases/{database}/documents {

    match /alumnos/{id} {
      allow read, write: if true;
    }

    match /pagos/{id} {
      allow read, write: if true;
    }

    match /cambios_turno/{id} {
      allow read, write: if true;
    }

    match /profesores/{id} {
      allow read, write: if true;
    }

    match /clases/{claseId} {
      allow read, write: if true;
    }

    // Necesario para collectionGroup queries sobre 'asistencias'
    match /{path=**}/asistencias/{alumnoId} {
      allow read, write: if true;
    }

    match /config/{id} {
      allow read, write: if true;
    }

    match /productos/{id} {
      allow read, write: if true;
    }

    match /facturas/{id} {
      allow read, write: if true;
    }
  }
}
